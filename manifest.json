{
  "manifest_version": 3,
  "name": "SNS Time Tracker",
  "version": "0.1.0",
  "description": "Track YouTube and Instagram usage time",
  "permissions": ["tabs", "storage"],
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://www.instagram.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
